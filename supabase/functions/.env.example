# Copia este archivo como supabase/functions/.env (está en .gitignore) y súbelo con:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref evfvcvllsjlakrpqmvdj
# Nunca subas el .env real a GitHub.

# Gmail del restaurante que envía los correos de reserva
GMAIL_USER=tu-correo@gmail.com
# Contraseña de aplicación de 16 caracteres (myaccount.google.com/apppasswords); los espacios se ignoran
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Nombre del remitente que ve el cliente
MAIL_FROM_NAME=Ámbar Restaurante

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional
GEMINI_MODEL=gemini-2.5-flash
